{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Saga",
  "colors": {
    "primary": "#BA9939",
    "light": "#E0C666",
    "dark": "#987508"
  },
  "fonts": {
    "heading": {
      "family": "Raleway",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "guides/getting-started"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "guides/matters",
              "guides/chat",
              "guides/legal-research",
              "guides/grid-review",
              "guides/translate",
              "guides/workflows"
            ]
          },
          {
            "group": "Administration",
            "pages": [
              "guides/admin-panel"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://docs.saga.com",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://saga.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@saga.com"
      }
    ] 
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/saga",
      "github": "https://github.com/saga",
      "linkedin": "https://linkedin.com/company/saga"
    }
  }
}
